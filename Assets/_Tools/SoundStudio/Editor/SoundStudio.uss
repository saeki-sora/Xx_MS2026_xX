/* サウンドスタジオだけの見た目。土台の色・部品は StudioKit.uss の変数を使う。 */

.ss-hidden {
    display: none;
}

/* 上の帯 */
.ss-header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.ss-header-count {
    color: var(--sk-text);
    -unity-font-style: bold;
    margin-right: 10px;
}

.ss-header-toggle {
    margin-right: 8px;
}

.ss-header-search {
    width: 140px;
    margin-right: 8px;
}

.ss-header-master {
    width: 120px;
    margin-right: 6px;
}

.ss-header-master > Label {
    min-width: 34px;
}

/* 行 */
.ss-rows {
    margin-bottom: 6px;
}

.ss-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin-bottom: 2px;
    border-radius: 6px;
    background-color: var(--sk-card);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.ss-row:hover {
    background-color: var(--sk-card-hover);
}

.ss-row--selected {
    border-color: var(--sk-accent);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0;
}

.ss-row-chevron {
    width: 14px;
    color: var(--sk-faint);
    font-size: 11px;
}

.ss-row--selected .ss-row-chevron {
    color: var(--sk-accent);
}

.ss-row--flash {
    background-color: rgba(95, 211, 155, 0.30);
}

.ss-row-mark {
    width: 12px;
    color: var(--sk-accent-2);
    font-size: 9px;
}

.ss-row-name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-width: 160px;
}

.ss-row-label {
    color: var(--sk-text);
    margin-right: 6px;
}

.ss-row-owner {
    color: var(--sk-faint);
    font-size: 11px;
    margin-right: 6px;
}

.ss-row-sound {
    width: 190px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.ss-row-sound--empty {
    color: var(--sk-accent);
    border-color: var(--sk-accent);
}

.ss-row-scale {
    width: 110px;
    margin-left: 6px;
    margin-right: 6px;
}

.ss-row-play {
    width: 32px;
}

.ss-row-play--playing {
    color: var(--sk-accent);
    border-color: var(--sk-accent);
}

/* まだ欄がない候補: 紫の点線 */
.ss-inactive-fold {
    margin-bottom: 8px;
}

.ss-inactive-fold > Toggle {
    color: var(--sk-sub);
}

.ss-row--inactive {
    opacity: 0.45;
}

.ss-masters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.ss-master {
    flex-direction: row;
    align-items: center;
    width: 300px;
    margin-right: 16px;
}

.ss-master > #label {
    width: 44px;
    color: var(--sk-text);
}

.ss-master-slider {
    flex-grow: 1;
}

.ss-row--candidate {
    background-color: rgba(167, 139, 250, 0.08);
    border-color: rgba(167, 139, 250, 0.55);
    border-width: 1px;
}

.ss-row-candidate-note {
    color: #B9A6FF;
    font-size: 11px;
    margin-left: 8px;
}

/* 細かい設定（選んだ行のすぐ下に、行とつながって開く） */
.ss-detail {
    margin-bottom: 8px;
    padding: 8px 12px 10px 12px;
    background-color: var(--sk-panel);
    border-width: 0 1px 1px 1px;
    border-color: var(--sk-accent);
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.ss-detail-columns {
    flex-direction: row;
    flex-wrap: wrap;
}

.ss-detail-columns > .ss-detail-card {
    flex-grow: 1;
    flex-basis: 340px;
}

.ss-detail-card {
    margin: 4px 8px 4px 0;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: var(--sk-card);
}

.ss-detail-card-title {
    color: var(--sk-text);
    -unity-font-style: bold;
}

.ss-detail-card-body {
    color: var(--sk-faint);
    font-size: 11px;
    margin-bottom: 4px;
}

.ss-detail-buttons {
    margin-top: 6px;
}

.ss-detail-where {
    color: var(--sk-sub);
    margin-bottom: 6px;
}

.ss-detail-sound {
    color: var(--sk-text);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.ss-detail-pitch-row {
    flex-direction: row;
    align-items: center;
}

.ss-detail-pitch {
    width: 150px;
    margin-left: 8px;
    color: var(--sk-text);
}

.ss-detail-fixed {
    color: var(--sk-sub);
    margin-top: 4px;
}

.ss-detail-link {
    -unity-text-align: middle-left;
}

/* 音のファイルを落とす所 */
.ss-drop {
    border-width: 2px;
    border-color: var(--sk-line);
    border-radius: 8px;
    padding: 18px;
    align-items: center;
}

.ss-drop-label {
    color: var(--sk-sub);
}

.ss-drop--over {
    border-color: var(--sk-accent);
    background-color: var(--sk-accent-soft);
}

/* Play 中に鳴った場面のナビ */
.ss-nav--flash {
    background-color: rgba(95, 211, 155, 0.30);
}
