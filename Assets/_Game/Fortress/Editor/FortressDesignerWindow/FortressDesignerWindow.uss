/* Fortress Designer - Editor Window styles.
   GripInputBridgeWindow(Assets/_Tools/GripInputBridge/Editor/GripInputBridgeWindow)と
   同じダーク基調・配色ルールに揃えている。IMGUI部分(タブの主要コンテンツ)は
   EditorStyles/EditorGUILayoutの既定の見た目に従う。 */

.fd-root {
    padding: 6px;
}

.fd-tab-bar {
    flex-direction: row;
    margin-bottom: 6px;
}

.fd-tab-button {
    flex-grow: 1;
    height: 30px;
    margin-right: 2px;
    -unity-font-style: bold;
}

.fd-tab-button--active {
    background-color: rgba(90, 140, 220, 0.45);
}

.fd-content-root {
    flex-grow: 1;
}

.fd-fill-root {
    flex-grow: 1;
}

.fd-tab-content {
    padding: 4px 2px;
}

.fd-section-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.fd-help-text {
    white-space: normal;
    margin-bottom: 10px;
    opacity: 0.85;
}

.fd-getting-started-step {
    margin-bottom: 10px;
    padding: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.03);
}

.fd-getting-started-step-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.fd-step-button {
    margin-top: 6px;
    max-width: 220px;
}

/* カメラタブ: 上にプレビューを固定し、下の設定だけをスクロールさせる */
.fd-camera-tab {
    flex-grow: 1;
    padding-bottom: 0;
}

.fd-camera-pinned {
    flex-shrink: 0;
}

.fd-camera-preview-cells {
    flex-grow: 1;
    min-height: 40px;
    margin-top: 4px;
}

.fd-camera-settings {
    flex-grow: 1;
}

/* 上下の境目(ドラッグで高さを変える) */
.fd-pane-splitter {
    height: 8px;
    flex-shrink: 0;
    margin: 1px 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    cursor: resize-vertical;
}

.fd-pane-splitter:hover,
.fd-pane-splitter--dragging {
    background-color: rgba(90, 140, 220, 0.35);
}

.fd-pane-splitter__grip {
    width: 40px;
    height: 2px;
    border-radius: 1px;
    background-color: rgba(255, 255, 255, 0.35);
}
